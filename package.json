{
  "name": "little-things-gift-baskets",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:dist": "node scripts/serve-dist.mjs",
    "test": "ng test",
    "import:catalog": "node scripts/import-catalog.mjs && node scripts/build-reviews.mjs && node scripts/build-sitemap.mjs && node scripts/build-thumbs.mjs",
    "sitemap": "node scripts/build-sitemap.mjs",
    "prebuild": "node scripts/build-sitemap.mjs && node scripts/build-thumbs.mjs",
    "e2e": "playwright test",
    "e2e:report": "playwright show-report e2e-report",
    "reviews": "node scripts/build-reviews.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "~21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "~21.2.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@mhfrough/star-rating": "1.0.1",
    "lucide-angular": "^1.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
